{
  "name": "mealsight",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Photograph a meal and get a structured breakdown you can correct, using open vision and language models.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write \"{app,lib,components,tests}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{app,lib,components,tests}/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
