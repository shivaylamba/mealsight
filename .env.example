# Nebius Token Factory. Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# There is no default model on purpose: an unset model fails loudly rather
# than quietly billing one you did not choose. Any vision-capable catalog
# model works; these two are a reasonable starting pair.
NEBIUS_VISION_MODEL=moonshotai/Kimi-K3
NEBIUS_COACH_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Optional. Defaults to the Token Factory endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Some models truncate under constrained decoding. Set this to json_object to
# put the schema in the prompt instead; Zod validates the reply either way.
NEBIUS_RESPONSE_FORMAT=json_schema

# Optional. Voice input and read-aloud. Without it the app works by typing.
# Get a key at https://gradium.ai
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
