# Nebius Token Factory. Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# There is no default model on purpose: an unset model fails loudly rather
# than quietly billing one you did not choose. Any vision-capable catalog
# model works; these two are a reasonable starting pair.
NEBIUS_VISION_MODEL=moonshotai/Kimi-K3
NEBIUS_COACH_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Optional. Defaults to the Token Factory endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# How the schema reaches the model. json_object puts it in the prompt and is
# the default because it is measurably more reliable: over ten runs of the two
# hardest descriptions, constrained json_schema decoding failed three times
# against one. Zod validates the reply either way, so the only difference is
# how often you see a failure. Try json_schema if your model handles it well.
NEBIUS_RESPONSE_FORMAT=json_object

# Optional. Voice input and read-aloud. Without it the app works by typing.
# Get a key at https://gradium.ai
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
